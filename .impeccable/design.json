  "narrative": {
    "northStar": "The Olive Editorial Research Desk",
    "overview": "Fisk makes evidence approachable through an observant cat identity, open white layouts, tightly set medium-weight type, and small composed research widgets. Charcoal ink and silver highlights connect the public editorial experience to a focused dark charcoal research desk. Distinct grey surfaces distinguish supporting evidence panels rather than becoming status colors.\n\nThe supplied video and FISK-VIDEO-UI-BRIEF.md establish the editorial foundation. The approved cat identity refinement preserves its layout, palette, spacing, responsive composition and native scrolling. The visual system serves a precise, calm, evidence-led product: questions lead to cited research, uncertainty stays visible, and the user makes the decision. Product capabilities remain governed by PRODUCT.md and functioning integrations; illustrations are not proof of live coverage or performance.",
    "keyCharacteristics": [
      "Observant cat identity",
      "Asymmetric composition",
      "Restrained medium-weight headlines",
      "Charcoal/silver contrast",
      "Soft pills",
      "Miniature evidence widgets",
      "Tonal depth",
      "Readable research density"
    ],
    "rules": [
      {
        "name": "The Evidence Stays Visible Rule",
        "body": "Keep source labels, freshness and honest provider states beside the material they qualify.",
        "section": "colors"
      },
      {
        "name": "The Overlay Elevation Rule",
        "body": "Reserve pronounced shadows for functional overlays and the fixed mobile composer.",
        "section": "elevation"
      },
      {
        "name": "The Shared Observer Rule",
        "body": "Use the shared terminal-like cat mark and consistent adult olive cat anatomy in the existing brand illustration frames; retain factual imagery in reporting.",
        "section": "components"
      },
      {
        "name": "The Useful Action Rule",
        "body": "Keep distinct navigation, source access and research context; remove repeated generic desk entries and inert affordances.",
        "section": "components"
      }
    ],
    "dos": [
      "Do compose brand illustrations and reporting imagery with sufficient neutral shading for readable text.",
      "Do preserve the shared cat anatomy and warm study across brand appearances, while keeping factual news images tied to their reporting.",
      "Do preserve asymmetric heights and different panel roles.",
      "Do keep timestamps, uncertainty, source links and provider failures visible.",
      "Do use public exploration before authentication; sign-in supports remembering and personalization."
    ],
    "donts": [
      "Don't return to the monochrome particle hero or generic centered gradient composition.",
      "Don't invent customer logos, endorsements, live values, coverage statistics or predicted returns.",
      "Don't add repeated generic desk actions or decorative controls that imply unavailable behavior.",
      "Don't turn every surface into identical cards, large shadows or glass panels.",
      "Don't make essential content wait for motion or repeatedly hide content during scrolling."
    ]
  },
  "description": "Monochrome Fisk editorial interface at 80% scale, preserving the cat identity and established layout."
}
